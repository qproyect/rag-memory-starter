# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database Configuration (PostgreSQL + pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag_memory

# LLM Providers Configuration
# Primary: mock | openai | ollama
PRIMARY_LLM_PROVIDER=mock
FALLBACK_LLM_PROVIDERS=ollama,openai
PROVIDER_TIMEOUT_MS=5000

# Optional Provider Credentials (ONLY needed if primary or fallback is openai/ollama)
# OPENAI_API_KEY=your-api-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-3.5-turbo
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3
# OLLAMA_EMBEDDING_MODEL=all-minilm
